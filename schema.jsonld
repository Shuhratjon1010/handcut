{
 "@context": "https://schema.org",
 "@graph": [
  {
   "@type": "MobileApplication",
   "name": "Handcut",
   "operatingSystem": "iOS 17+",
   "applicationCategory": "MultimediaApplication",
   "url": "https://apps.apple.com/app/id6762062166",
   "offers": [
    {
     "@type": "Offer",
     "name": "Handcut Free",
     "price": "0",
     "priceCurrency": "USD"
    },
    {
     "@type": "Offer",
     "name": "Handcut Pro Monthly",
     "price": "1.00",
     "priceCurrency": "USD",
     "category": "subscription",
     "description": "US$1/month, or the local equivalent shown in the app"
    }
   ],
   "description": "iPhone video editor with on-device, word-by-word captions and no watermark on any tier."
  },
  {
   "@type": "FAQPage",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "Does Handcut add a watermark?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. There is no watermark on any tier, free or Pro."
     }
    },
    {
     "@type": "Question",
     "name": "Is Handcut free?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes, to download and use. The free core includes on-device captions, 4K export up to 60 fps, no watermark, and the core timeline. HandCut Pro is a monthly plan at US$1/month, or the local equivalent shown in the app. Existing purchases stay valid and can be restored in the app."
     }
    },
    {
     "@type": "Question",
     "name": "Do I need an account?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. Handcut asks for no account and shows no ads."
     }
    },
    {
     "@type": "Question",
     "name": "How are captions exported?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Captions are burned into the exported video."
     }
    },
    {
     "@type": "Question",
     "name": "Which languages are supported?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Handcut uses Apple on-device speech recognition. English is the primary supported language; other languages depend on what your iPhone supports."
     }
    },
    {
     "@type": "Question",
     "name": "Is Handcut available on Android?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. Handcut is iPhone only (iOS 17 or later)."
     }
    }
   ]
  }
 ]
}
